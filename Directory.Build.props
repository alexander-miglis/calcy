<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <Authors>Alexander Miglis</Authors>
    <Copyright>Copyright (c) 2026 Alexander Miglis</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alexander-miglis/calcy</RepositoryUrl>
    <Product>Calcy</Product>
    <!-- The next release. CI builds pass -p:Version=... (for example 0.1.0-pre.12); bump this when you release. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
