<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Calcy.UI.Theming"
             x:Class="Calcy.App.App"
             Name="Calcy"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <theme:CalcyTheme />
  </Application.Styles>
</Application>
