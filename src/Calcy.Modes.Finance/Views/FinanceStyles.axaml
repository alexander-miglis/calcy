<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Calcy.Modes.Finance.Views.FinanceStyles">

  <!-- Boxes -->
  <Style Selector="Border.tabstrip">
    <Setter Property="Background" Value="{DynamicResource Calcy.Key}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,4" />
    <Setter Property="Padding" Value="10,8,10,10" />
  </Style>
  <Style Selector="Border.solved">
    <Setter Property="Background" Value="{DynamicResource Calcy.Sel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Line}" />
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.solved.problem">
    <Setter Property="Background" Value="{DynamicResource Calcy.Paper}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Err}" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource Calcy.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Line}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.tile.sel">
    <Setter Property="Background" Value="{DynamicResource Calcy.Sel}" />
  </Style>
  <Style Selector="Border.box">
    <Setter Property="Background" Value="{DynamicResource Calcy.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Line}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="Border.box.sel">
    <Setter Property="Background" Value="{DynamicResource Calcy.Sel}" />
  </Style>
  <Style Selector="Border.chart">
    <Setter Property="Background" Value="{DynamicResource Calcy.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Line}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.section">
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Key}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="Padding" Value="0,0,0,18" />
    <Setter Property="Margin" Value="0,0,0,18" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Line}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.cap">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Label}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.meaning">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Body}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Body}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Body}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Body}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Err}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Math}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.tilevalue">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Math}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mathline">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Math}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.words">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Body}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cardinput">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Math}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.cardresult">
    <Setter Property="FontFamily" Value="{DynamicResource Calcy.Font.Math}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Calcy.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox.fin">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.fin.small">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="TextBox.fin.left">
    <Setter Property="TextAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBox.solved /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Calcy.Sel}" />
  </Style>
  <Style Selector="TextBox.error /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Calcy.Err}" />
  </Style>
</Styles>
